{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/indigo-evolve", "destination": "/indigo_evolve.html" },
    { "source": "/indigo_evolve", "destination": "/indigo_evolve.html" }
  ],
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
